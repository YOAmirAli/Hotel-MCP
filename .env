# Environment variables for Hotel-MCP
# Replace placeholder values with your actual credentials and database connection.

NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_mcp?schema=public"
JWT_SECRET=replace_with_your_jwt_secret

# Twilio WhatsApp credentials
TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Stripe keys
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Claude AI key for chat API integration
CLAUDE_API_KEY=replace_with_your_claude_api_key
